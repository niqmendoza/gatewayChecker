# Copiar a .env junto a probe_llm.py. El entorno externo tiene prioridad.
# LiteLLM: sólo estas dos variables son necesarias.
GATEWAY_URL=https://litellm.example.com/v1
GATEWAY_KEY=

# Opcional: ID exacto si /models no identifica un único GPT-5.6 Sol.
# GATEWAY_MODEL=alias-del-modelo
# GATEWAY_AUTH=bearer

# Sólo para --route azure o --route both; model = nombre del despliegue.
# AZURE_URL=https://recurso.openai.azure.com/openai/v1
# AZURE_KEY=
# AZURE_MODEL=nombre-del-despliegue
# AZURE_AUTH=api-key
# Para Entra ID: AZURE_AUTH=bearer y un token vigente en AZURE_KEY.
